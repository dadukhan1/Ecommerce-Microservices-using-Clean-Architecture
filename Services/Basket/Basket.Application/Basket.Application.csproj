<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Basket.Core\Basket.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Grpc.AspNetCore" Version="2.85.0" />
		<PackageReference Include="Grpc.Net.Client" Version="2.85.0" />
		<PackageReference Include="Grpc.Tools" Version="2.85.0">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="MediatR" Version="14.3.0" />
	</ItemGroup>

	<ItemGroup>
	  <Protobuf Include="Protos\Discount.proto" GrpcServices="Client" />
	</ItemGroup>
</Project>
